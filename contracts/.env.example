# contracts/.env.example — kopyala: cp .env.example .env  (`.env` .gitignore'dadır; forge script `.env`'i otomatik okur)
# Deployer anahtarı repoda TUTULMAZ: `source ~/.config/traderkirala/monad-testnet-deployer.env` ile ortamdan gelir.

# Monad Testnet deployer / vault owner özel anahtarı (0x…64 hex). scripts/deploy-testnet.sh --private-key olarak kullanır.
MONAD_DEPLOYER_PRIVATE_KEY=

# Faucet minter adresi (backend MINTER_KEY'in adresi). Verilirse 3 TestToken'da MINTER_ROLE alır; boşsa yalnız deployer mint eder.
MINTER_ADDRESS=

# Platform ücreti (bps, 0..1000). Testnet başlangıcı 0.
PLATFORM_FEE_BPS=0

# Router değişikliği gecikmesi (saniye, 0..2592000). Testnet için 0 (anlık) veya 600; ana ağ 86400.
ROUTER_DELAY=0

# Opsiyonel
# SETTLE_SLIPPAGE_BPS=100          # settle re-check toleransı (bps, 0..5000)
# FEE_RECIPIENT=                   # boşsa deployer
# DEPLOYMENT_NAME=monad-testnet    # deploy-testnet.sh / anvil-local.sh kendisi ayarlar (monad-testnet | anvil-local)
# MONADSCAN_API_KEY=               # etherscan-uyumlu verify alternatifi için
